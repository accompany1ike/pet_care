# Copy this file to .env.local and replace the placeholders.
# Use the Supabase PostgreSQL Session Pooler connection string, not the browser anon key.
#
# Template:
# DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Example shape only:
# DATABASE_URL="postgresql://postgres.abcdefghijklmnopqrst:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL=""
